{
  "name": "@webstackbuilders/plugin-ai-agent-frontend-scaffolder-ai-shadow-detective",
  "version": "0.0.1",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "description": "Standalone Backstage UI for cloud shadow resource reports.",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "scaffolder-ai-shadow-detective"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.ts"
  },
  "sideEffects": false,
  "scripts": {
    "start": "backstage-cli package start",
    "build": "yarn --cwd ../../.. tsc -b plugins/frontend/plugin-ai-agent-frontend-scaffolder-ai-shadow-detective/tsconfig.json --emitDeclarationOnly && backstage-cli package build",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "typecheck": "tsc --noEmit",
    "lint": "backstage-cli package lint --format stylish",
    "test": "yarn --cwd ../../.. vitest run plugins/frontend/plugin-ai-agent-frontend-scaffolder-ai-shadow-detective/src --config test/vitest.config.ts"
  },
  "dependencies": {
    "@backstage/core-components": "backstage:^",
    "@backstage/core-plugin-api": "backstage:^",
    "@backstage/frontend-plugin-api": "backstage:^",
    "@material-ui/core": "^4.12.4",
    "eventsource-parser": "^2.0.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@backstage/dev-utils": "backstage:^",
    "@backstage/test-utils": "backstage:^",
    "@testing-library/react": "^16.3.2",
    "@types/react": "*",
    "@types/react-dom": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "vitest": "^4.1.11"
  }
}

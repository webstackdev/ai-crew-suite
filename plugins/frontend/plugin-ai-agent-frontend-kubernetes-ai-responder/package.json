{
  "name": "@webstackbuilders/plugin-ai-agent-frontend-kubernetes-ai-responder",
  "version": "0.0.1",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "description": "Frontend user interface for the Kubernetes AI responder: trigger a read-only incident investigation, follow it live over SSE, and inspect the cited evidence and triage report.",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "frontend",
    "webstack-builders",
    "ai-crew-suite",
    "ai-core",
    "kubernetes",
    "incident-response"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "kubernetes-ai-responder"
  },
  "bugs": {
    "url": "https://github.com/webstackdev/ai-crew-suite/issues",
    "email": "support@webstackbuilders.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webstackdev/ai-crew-suite",
    "directory": "plugins/frontend/plugin-ai-agent-frontend-kubernetes-ai-responder"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.ts"
  },
  "sideEffects": false,
  "scripts": {
    "start": "backstage-cli package start",
    "build": "yarn --cwd ../../.. tsc -b plugins/frontend/plugin-ai-agent-frontend-kubernetes-ai-responder/tsconfig.json --emitDeclarationOnly && backstage-cli package build",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "typecheck": "tsc --noEmit",
    "lint": "backstage-cli package lint --format stylish",
    "test": "vitest run src --exclude 'dist-types/**' --passWithNoTests"
  },
  "dependencies": {
    "@backstage/core-components": "backstage:^",
    "@backstage/core-plugin-api": "backstage:^",
    "@backstage/frontend-plugin-api": "backstage:^",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "eventsource-parser": "^2.0.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@backstage/dev-utils": "backstage:^",
    "@backstage/test-utils": "backstage:^",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "*",
    "@types/react-dom": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  }
}

{
  "name": "@webstackbuilders/plugin-ai-agent-frontend-core",
  "version": "0.0.1",
  "main": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "default": "./src/index.ts"
    },
    "./alpha": {
      "types": "./dist/alpha.d.ts",
      "default": "./src/alpha.ts"
    }
  },
  "license": "Apache-2.0",
  "description": "Common library and base classes for use in AI Crew Suite frontend plugins.",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "frontend",
    "webstack-builders",
    "ai-crew-suite",
    "ai-core"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "web-library"
  },
  "bugs": {
    "url": "https://github.com/ai-crew-suite/ai-crew-suite/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/ai-crew-suite",
    "directory": "plugins/frontend/plugin-ai-agent-frontend-core"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "typecheck": "tsc --noEmit",
    "lint": "backstage-cli package lint --format stylish",
    "test": "vitest run src --exclude 'dist-types/**' --passWithNoTests"
  },
  "dependencies": {
    "@backstage/core-components": "backstage:^",
    "@backstage/core-plugin-api": "backstage:^",
    "@backstage/frontend-plugin-api": "backstage:^",
    "eventsource-parser": "^2.0.1",
    "vitest": "^4.1.11"
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@backstage/dev-utils": "backstage:^",
    "@backstage/test-utils": "backstage:^",
    "@testing-library/user-event": "^14.6.7"
  }
}

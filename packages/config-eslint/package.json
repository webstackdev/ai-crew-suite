{
  "name": "@ai-crew-suite/config-eslint",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "ai-crew-eslint": "./dist/bin/ai-crew-eslint.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./node": "./dist/eslint.package-node.config.js",
    "./web": "./dist/eslint.package-web.config.js",
    "./monorepo": "./dist/eslint.monorepo.config.js",
    "./role": "./dist/eslint.package-role.config.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "node ./dist/bin/ai-crew-eslint.js --role node-library src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@backstage/eslint-plugin": "backstage:^",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-header": "3.1.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript-eslint": "^8.69.0"
  },
  "devDependencies": {
    "@types/node": "catalog:node-types",
    "rimraf": "catalog:rimraf",
    "typescript": "catalog:typescript",
    "vitest": "catalog:vitest"
  }
}

{
  "name": "@ai-crew-suite/cli",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "crew": "./dist/bin/crew.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn clean && rollup --config rollup.config.ts --configPlugin typescript",
    "clean": "rimraf dist",
    "lint": "node ./dist/bin/crew.js --role node-library src --max-warnings 0",
    "publish": "npm publish",
    "test": "yarn test:run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@backstage/eslint-plugin": "backstage:^",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-header": "3.1.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.0.1",
    "rimraf": "catalog:rimraf",
    "typescript": "catalog:typescript",
    "typescript-eslint": "^8.70.0",
    "vitest": "catalog:vitest"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:node-types",
    "rollup": "^4.63.1"
  }
}

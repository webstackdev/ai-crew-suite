{
  "name": "@ai-crew-suite/eslint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ai-crew-suite-eslint": "./dist/bin/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npx chmod +x dist/bin/index.js",
    "clean": "rimraf dist",
    "lint": "node ./dist/bin/index.js --role node-library src --max-warnings 0",
    "test": "yarn test:unit",
    "typecheck": "tsc --noEmit",
    "test:unit": "ai-crew-suite-vitest"
  },
  "dependencies": {
    "@backstage/eslint-plugin": "backstage:^",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-header": "3.1.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript-eslint": "^8.70.0"
  },
  "devDependencies": {
    "@types/node": "catalog:node-types",
    "rimraf": "catalog:rimraf",
    "typescript": "catalog:typescript",
    "vitest": "catalog:vitest"
  }
}

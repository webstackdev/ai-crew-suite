{
  "name": "@webstackbuilders/storybook-workspace-infra",
  "private": true,
  "version": "1.0.0",
  "main": "./src/index.ts",
  "exports": {
    "./src/utils/mockUtils": "./src/utils/mockUtils.ts",
    "./src/mocks/mockApis": "./src/mocks/mockApis.ts"
  },
  "scripts": {
    "lint": "yarn --cwd ../.. exec eslint packages/storybook/src --max-warnings 0",

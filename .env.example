# ──────────────────────────────────────────────────────────────────────────────
# 🧰 AI CREW SUITE: UNIFIED RUNTIME ENVIRONMENT CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to '.env' in your repository root to configure local execution.
# Variables listed here must be declared in 'turbo.json' under global or task env
# arrays to ensure Turborepo does not experience broken cache-invalidation loops.

# ──────────────────────────────────────────────────────────────────────────────
# 🚀 SYSTEM DEFAULTS & GLOBAL FLAGS
# ──────────────────────────────────────────────────────────────────────────────

# NODE_ENV: Dictates runtime optimization loops ('development', 'production', 'test')
NODE_ENV=development

# CI: Forces continuous integration rules (strict warnings, parallel worker throttles)
CI=false

# ──────────────────────────────────────────────────────────────────────────────
# 🗺️ BACKSTAGE APP CONFIGURATION DEVIATIONS
# ──────────────────────────────────────────────────────────────────────────────

# BACKSTAGE_APP_CONFIG: Forces the Backstage loader to read specific local overrides
# rather than defaulting solely to base app-config.yaml structures.
BACKSTAGE_APP_CONFIG=app-config.local.yaml

# ──────────────────────────────────────────────────────────────────────────────
# 🔑 CRUCIAL ENTERPRISE SECURITY SECRETS (Missing from basic setups)
# ──────────────────────────────────────────────────────────────────────────────

# BACKSTAGE_USER_SECRET: Secure token key used to encrypt cookie storage states.
# Generate a cryptographically secure random 24-character string for local use.
BACKSTAGE_USER_SECRET=development-only-token-secret-xyz

# POSTGRES_USER: Root authentication username for your Backstage Database cluster.
POSTGRES_USER=postgres

# POSTGRES_PASSWORD: Database password token.
# Note: In production/CI, prefer injecting these parameters via secrets vaults.
POSTGRES_PASSWORD=postgres

# ──────────────────────────────────────────────────────────────────────────────
# 🌐 PLAYWRIGHT END-TO-END (E2E) TESTING PLATFORM PARAMETERS
# ──────────────────────────────────────────────────────────────────────────────

# Customizes hosts and socket channels to circumvent port-binding collisions.
PLAYWRIGHT_APP_HOST=http://localhost
PLAYWRIGHT_APP_PORT=3000
PLAYWRIGHT_BACKEND_HOST=http://localhost
PLAYWRIGHT_BACKEND_PORT=7007

# 📢 DEPLOYMENT WORKFLOW NOTIFICATIONS (CI/CD INTEGRATIONS)
# ──────────────────────────────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL: Webhook URL used by your master publishing runners to broadcast
# build successes, delivery statuses, or compiler crash alerts.
SLACK_WEBHOOK_URL=https://slack.com

{
  "$schema": "https://turbo.build",
  "concurrency": "75%",
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "BACKSTAGE_APP_CONFIG",
    "BACKSTAGE_USER_SECRET",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "sync"],
      "outputs": ["dist/**"],
      "env": [
        "FORCE_COLOR",
        "PLAYWRIGHT_APP_HOST",
        "PLAYWRIGHT_APP_PORT",
        "PLAYWRIGHT_BACKEND_HOST",
        "PLAYWRIGHT_BACKEND_PORT"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "start-backend": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "storybook:build": {
      "dependsOn": ["^build"],
      "outputs": ["packages/storybook/storybook-static/**"],
      "cache": true
    },
    "sync": {
      "inputs": [
        "apps/**/package.json",
        "packages/**/package.json",
        "plugins/**/package.json"
      ],
      "outputs": [
        "apps/**/tsconfig.json",
        "packages/**/tsconfig.json",
        "plugins/**/tsconfig.json",
        "tsconfig.json"
      ]
    },
    "test:e2e": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "plugins/**/*.ts",
        "plugins/**/*.tsx",
        "**/src/**/*.e2e.test.ts"
      ],
      "outputs": [
        "playwright-report/**",
        "test-results/**"
      ],
      "env": [
        "PLAYWRIGHT_APP_HOST",
        "PLAYWRIGHT_APP_PORT",
        "PLAYWRIGHT_BACKEND_HOST",
        "PLAYWRIGHT_BACKEND_PORT",
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_BACKEND_HEALTH_URL",
        "CI"
      ]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*",
        "src/**/*.test.ts",
        "src/**/*.test.tsx"
      ],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}

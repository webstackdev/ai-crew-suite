# ==========================================
# 1. System & OS Artifacts
# ==========================================

.classpath
.DS_Store
.DS_Store?
.idea/
.project
.settings/
*.sublime-project
*.sublime-workspace
ehthumbs.db
Log.txt
Thumbs.db

# ==========================================
# 2. Local Configuration & Environment Files
# ==========================================

.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.sqlite
.clinerules

# ==========================================
# 3. Build Outputs & Compiled Code
# ==========================================

# Bundled production builds (local to packages/plugins)
dist/

# Local type declaration outputs generated by tsc --build
dist-types/

# TypeScript Project References cache files tracking incremental builds
*.tsbuildinfo

# General cache directories
.command-cache/
artifacts/

# Turbo repository cache directories
.turbo
**/.turbo

# Incremental compilation cache files generated by TypeScript
*.tsbuildinfo

# ==========================================
# 4. Yarn 4 Plug'n'Play (PnP) Specifics
# ==========================================

node_modules/

# Ignore the transient path installation state cache file
.yarn/install-state.gz

# Standard Install (Keeps Git history lightweight)
# This ignores the heavy zip archive cache, forcing developers to run `yarn install` on clone.
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml

# NEVER ignore these critical Yarn orchestration and development files
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/sdks/

# ==========================================
# 5. Python Specifics
# ==========================================

.venv

# ==========================================
# 6. Testing & Verification Artifacts
# ==========================================

.pnp.*
.eslintcache
.stylelintcache
.prettiercache
coverage/
cypress/videos/
cypress/screenshots/
playwright-report/
test-results/
**/.vitest-cache
